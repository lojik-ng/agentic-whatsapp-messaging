{
  "name": "whatsapp-messaging-skill",
  "version": "1.0.0",
  "description": "Reusable WhatsApp Messaging skill for AI agents (Baileys): pairing-code auth, SQLite FTS5 message search, send/reply, and media download/upload via CLI and HTTP",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "whatsapp-messaging-skill": "./bin/whatsapp-skill.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "tsx src/index.ts",
    "serve": "tsx src/api/server.ts",
    "cli": "tsx bin/whatsapp-skill.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "ai-agent",
    "skill",
    "pairing-code",
    "chat",
    "attachments",
    "sqlite"
  ],
  "files": [
    "bin",
    "dist",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "author": "lojik-ng",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.3.1",
    "mime-types": "^2.1.35",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^25.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}

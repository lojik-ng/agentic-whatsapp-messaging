{
  "name": "whatsapp-skill",
  "version": "1.0.0",
  "description": "Reusable WhatsApp Web skill for AI Agents powered by Baileys with pairing code authentication, local SQLite search index, and complete attachment management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "whatsapp-skill": "./bin/whatsapp-skill.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "serve": "tsx src/api/server.ts",
    "cli": "tsx bin/whatsapp-skill.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "ai-agent",
    "skill",
    "pairing-code",
    "chat",
    "attachments",
    "search",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.3.1",
    "mime-types": "^2.1.35",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^25.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}

# WhatsApp Auth & Data Directories
WHATSAPP_AUTH_DIR=./data/auth
WHATSAPP_ATTACHMENTS_DIR=./data/attachments
WHATSAPP_DB_PATH=./data/whatsapp.db

# Automatic media download on receipt (true / false)
AUTO_DOWNLOAD_MEDIA=true
MAX_AUTO_DOWNLOAD_SIZE_MB=50

# Server / API Daemon Settings
PORT=3333
HOST=127.0.0.1
WHATSAPP_API_KEY=

# Logging level: trace, debug, info, warn, error, silent
LOG_LEVEL=info
